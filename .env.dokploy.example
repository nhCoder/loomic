# Copy these into Dokploy's Environment tab, or copy this file to .env
# for local `docker compose up --build` testing.

# Public app URL configured in Dokploy.
# Use your Dokploy HTTPS domain in production, for example:
# https://loomic.example.com
APP_URL=http://localhost:3000
WEB_PORT=3000

# The static frontend embeds this value at image build time.
# Keep it equal to APP_URL when using the included nginx same-origin /api proxy.
NEXT_PUBLIC_SERVER_BASE_URL=http://localhost:3000
LOOMIC_WEB_ORIGIN=http://localhost:3000

# Supabase - required
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:<password>@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Agent LLM - set at least one provider key
LOOMIC_AGENT_BACKEND_MODE=state
LOOMIC_AGENT_MODEL=google:gemini-2.5-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=

# Image/video providers
REPLICATE_API_TOKEN=

# Google Vertex AI, optional.
# Prefer GOOGLE_SERVICE_ACCOUNT_JSON in Docker/Dokploy. Paste the full JSON as one env var.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=
GOOGLE_VERTEX_VIDEO_LOCATION=

# Worker tuning
WORKER_ID=dokploy-w1
WORKER_CONCURRENCY=3
WORKER_IMAGE_CONCURRENCY=3
WORKER_VIDEO_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000

# Optional integrations
GOOGLE_FONTS_API_KEY=
VOLCES_API_KEY=
VOLCES_BASE_URL=

# Lemon Squeezy payments, optional
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=
LEMONSQUEEZY_VARIANT_STARTER_YEARLY=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_ULTRA_MONTHLY=
LEMONSQUEEZY_VARIANT_ULTRA_YEARLY=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTHLY=
LEMONSQUEEZY_VARIANT_BUSINESS_YEARLY=
